// AeroTick Compile-Fail Safety Demo (Immutable prev, Zero Heap, Bounded Control)
state Craft {
    pos: Vec3<m>;
    vel: Vec3<m/s>;
}

system FaultyControl(dt: s) {
    step(prev: Craft) -> next: Craft {
        prev.pos = prev.pos + prev.vel * dt;
        let scratch = alloc(128);
        while dt > 0.0 s {
            next.vel = prev.vel;
        }
        next.pos = next.pos + prev.vel * dt;
    }
}
